# WalkWithMe — Environment Variables
# Copy this file to .env.local and fill in your keys
# NEVER commit .env.local to git

# ── Backend ─────────────────────────────────────────────────────────────────
# URL of your FastAPI backend
# Local: http://localhost:8000
# Deployed: https://your-backend.railway.app
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# ── Google Maps ──────────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com
# Enable: Places API, Directions API, Geocoding API, Maps SDK for Android
EXPO_PUBLIC_GOOGLE_MAPS_KEY=your_google_maps_api_key_here

# ── OpenAI (backend only — NEVER expose on frontend) ──────────────────────
# Get from: https://platform.openai.com/api-keys
# Add this to your backend's .env file
OPENAI_API_KEY=your_openai_api_key_here

# ── Supabase (backend only) ──────────────────────────────────────────────────
# Get from: https://supabase.com/dashboard
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
